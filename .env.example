# Copie para .env (já está no .gitignore — nunca commitar o .env real) e
# preencha com valores reais. Usado por data/job_diario.py --upload-supabase
# (via lib_geracao.py:enviar_supabase) para subir os arquivos gerados
# localmente pro storage S3-compatible.

# Endpoint S3-compatible do seu storage (ex: Supabase Storage)
SUPABASE_S3_ENDPOINT=https://<seu-projeto>.storage.supabase.co/storage/v1/s3

# Credenciais S3 (Storage > Settings > S3 Connection no seu projeto Supabase)
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Bucket de destino
SUPABASE_BUCKET=datalake

# Opcional — default us-east-1
SUPABASE_S3_REGION=us-east-1
